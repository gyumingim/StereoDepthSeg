<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.scan3d.arlat"
    android:versionCode="1" android:versionName="0.1">
    <uses-sdk android:minSdkVersion="28" android:targetSdkVersion="34" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.ar" android:required="true" />
    <queries><package android:name="com.google.ar.core" /></queries>
    <application android:label="ARCore Latency" android:debuggable="true" android:extractNativeLibs="true"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <meta-data android:name="com.google.ar.core" android:value="required" />
        <meta-data android:name="com.google.ar.core.min_apk_version" android:value="241930000" />
        <activity android:name=".MainActivity" android:exported="true" android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
