<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.scan3d.arlat"
    android:versionCode="44" android:versionName="0.6.35d-npunight-20261029">
    <uses-sdk android:minSdkVersion="28" android:targetSdkVersion="34" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Streamer: socket to 127.0.0.1:8798 (adb reverse to the PC bench server) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- OvRunner: gyro/accel above 200 Hz for OpenVINS -->
    <uses-permission android:name="android.permission.HIGH_SAMPLING_RATE_SENSORS" />
    <!-- HsRecorder temps.csv: dump thermalservice for AP/CP/PA (granted over adb: pm grant com.scan3d.arlat android.permission.DUMP) -->
    <uses-permission android:name="android.permission.DUMP" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />
    <uses-feature android:name="android.hardware.camera.ar" android:required="true" />
    <!-- 0.6.20 ViopImuSender usb (optional, untested): phone IMU -> ESP32 over USB CDC -->
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />
    <queries><package android:name="com.google.ar.core" /></queries>
    <application android:label="ARCore Latency" android:debuggable="true" android:extractNativeLibs="true"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <meta-data android:name="com.google.ar.core" android:value="required" />
        <!-- 0.6.30 appnpu: vendor public library for the NPU (NpuLoop, only loaded with intent npu_loop 1); not required -->
        <uses-native-library android:name="libenn_public_api_cpp.so" android:required="false" />
        <meta-data android:name="com.google.ar.core.min_apk_version" android:value="241930000" />
        <activity android:name=".MainActivity" android:exported="true" android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
