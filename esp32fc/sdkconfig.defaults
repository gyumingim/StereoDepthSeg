# esp32fc — deterministic-timing settings (ESP32-S3, ESP-IDF v5.2+)
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_PM_ENABLE=n
CONFIG_FREERTOS_HZ=1000
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
# both cores; Wi-Fi / ESP-NOW and the esp_timer task stay on core 0 (control loop owns core 1)
CONFIG_FREERTOS_UNICORE=n
CONFIG_ESP_WIFI_TASK_PINNED_TO_CORE_0=y
CONFIG_ESP_TIMER_TASK_AFFINITY_CPU0=y
CONFIG_ESP_TIMER_ISR_AFFINITY_CPU0=y
CONFIG_TINYUSB_TASK_AFFINITY_CPU0=y
# ISRs / drivers in IRAM (no flash-cache stalls in the hot path)
CONFIG_SPI_MASTER_IN_IRAM=y
CONFIG_SPI_MASTER_ISR_IN_IRAM=y
CONFIG_RMT_ISR_IRAM_SAFE=y
CONFIG_GPTIMER_ISR_IRAM_SAFE=y
CONFIG_GPIO_CTRL_FUNC_IN_IRAM=y
# watchdogs: task WDT 1 s with panic -> reboot (motors stop: no DShot frames); interrupt WDT on
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=1
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=y
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=n
CONFIG_ESP_INT_WDT=y
CONFIG_ESP_INT_WDT_TIMEOUT_MS=300
CONFIG_ESP_SYSTEM_PANIC_PRINT_REBOOT=y
CONFIG_ESP_BROWNOUT_DET=y
# quiet logging (nothing logs from the loops)
CONFIG_LOG_DEFAULT_LEVEL_WARN=y
# USB OTG is used by TinyUSB (phone link): console on UART0
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_TINYUSB_CDC_ENABLED=y
CONFIG_TINYUSB_CDC_COUNT=1
# Wi-Fi: no power save for ESP-NOW latency
CONFIG_ESP_WIFI_STA_DISCONNECTED_PM_ENABLE=n
