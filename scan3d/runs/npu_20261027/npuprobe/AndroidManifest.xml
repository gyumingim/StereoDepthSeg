  <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="34"/>
  <application android:label="npuprobe" android:extractNativeLibs="true" android:hasCode="true">
    <uses-native-library android:name="libenn_public_api_cpp.so" android:required="false"/>
    <uses-native-library android:name="libenn_user.samsung_slsi.so" android:required="false"/>
    <uses-native-library android:name="libeden_rt_stub.edensdk.samsung.so" android:required="false"/>
  </application>
  <instrumentation android:name=".Probe" android:targetPackage="com.scan3d.npuprobe" android:label="npuprobe"/>
</manifest>
