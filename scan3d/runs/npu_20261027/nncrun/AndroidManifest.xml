<?xml version="1.0" encoding="utf-8"?>
<!-- nncrun 2026-10-27: headless .nnc runner (own code only, no permissions, NO activity / no UI: runs only through
     'am instrument' inside the app process = untrusted_app domain). debuggable only so that run-as can place the
     model/input in the app's private files dir. Uninstall after the test. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.scan3d.nncprobe" android:versionCode="1" android:versionName="1">
  <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="34"/>
  <application android:label="nncprobe" android:extractNativeLibs="true" android:hasCode="true" android:debuggable="true">
    <uses-native-library android:name="libenn_public_api_cpp.so" android:required="false"/>
  </application>
  <instrumentation android:name=".Probe" android:targetPackage="com.scan3d.nncprobe" android:label="nncprobe"/>
</manifest>
