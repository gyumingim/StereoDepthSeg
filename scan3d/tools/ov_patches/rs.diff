+void VioManager::rs_correct_features(const ov_core::CameraData &message) {
+  // Row time model: t(v) = t_frame + rs_readout_time * rs_row_scale * (v / H - 0.5). The frame stamp (t_mid = sensor ts +
+  // exposure/2 + skew/2) is the centre row, so the centre row is the reference. Body rate w_I (gyro - bias) is taken
+  // constant over the readout (mean of the IMU samples within readout/2 + 2 ms). Bearing at the reference time:
+  // b_ref = Exp(R_ItoC w_I tau) b_row, tau = t(v) - t_ref (pure rotation; translation and depth ignored).
+  double dt_ci = state->_calib_dt_CAMtoIMU->value()(0);
+  double t_imu = message.timestamp + dt_ci;
+  double half = 0.5 * std::abs(params.rs_readout_time) + 0.002;
+  Eigen::Vector3d wsum = Eigen::Vector3d::Zero();
+  int nw = 0;
+  for (const auto &m : rs_imu) {
+    if (m.timestamp >= t_imu - half && m.timestamp <= t_imu + half) {
+      wsum += m.wm;
+      nw++;
+    }
+  }
+  if (nw == 0) {
+    double best = 1e9;
+    for (const auto &m : rs_imu) {
+      if (std::abs(m.timestamp - t_imu) < best) {
+        best = std::abs(m.timestamp - t_imu);
+        wsum = m.wm;
+        nw = 1;
+      }
+    }
+    if (nw == 0 || best > 0.02)
+      return;
+  }
+  Eigen::Vector3d w_I = wsum / nw;
+  if (is_initialized_vio)
+    w_I -= state->_imu->bias_g();
+  auto db = trackFEATS->get_feature_database();
+  std::vector<std::shared_ptr<ov_core::Feature>> feats = db->features_containing(message.timestamp, false, true);
+  rs_n_frames++;
+  rs_sum_w += w_I.norm();
+  for (size_t cam_id : message.sensor_ids) {
+    Eigen::Matrix3d R_ItoC = state->_calib_IMUtoCAM.at(cam_id)->Rot();
+    Eigen::Vector3d w_C = R_ItoC * w_I;
+    auto cam = state->_cam_intrinsics_cameras.at(cam_id);
+    double H = (double)cam->h();
+    for (auto &f : feats) {
+      if (f->timestamps.find(cam_id) == f->timestamps.end())
+        continue;
+      auto &ts = f->timestamps.at(cam_id);
+      for (int k = (int)ts.size() - 1; k >= 0; k--) {
+        if (ts.at(k) != message.timestamp)
+          continue;
+        Eigen::VectorXf &uv = f->uvs.at(cam_id).at(k);
+        Eigen::VectorXf &un = f->uvs_norm.at(cam_id).at(k);
+        double tau = params.rs_readout_time * params.rs_row_scale * ((double)uv(1) / H - 0.5);
+        Eigen::Vector3d b((double)un(0), (double)un(1), 1.0);
+        Eigen::Vector3d b2 = ov_core::exp_so3(w_C * tau) * b;
+        Eigen::Vector2f n2((float)(b2(0) / b2(2)), (float)(b2(1) / b2(2)));
+        Eigen::Vector2f uv2 = cam->distort_f(n2);
+        double sh = std::sqrt(std::pow((double)uv2(0) - uv(0), 2) + std::pow((double)uv2(1) - uv(1), 2));
+        rs_sum_shift += sh;
+        rs_max_shift = std::max(rs_max_shift, sh);
+        rs_n_feats++;
+        uv(0) = uv2(0);
+        uv(1) = uv2(1);
+        un(0) = n2(0);
+        un(1) = n2(1);
+        break;
+      }
+    }
+  }
+  if (rs_n_frames % 300 == 0) {
+    PRINT_WARNING("[RS] frames %ld feats %ld mean_shift_px %.4f max_shift_px %.4f mean_w_rad_s %.4f\n", rs_n_frames, rs_n_feats,
+                  rs_n_feats ? rs_sum_shift / rs_n_feats : 0.0, rs_max_shift, rs_sum_w / rs_n_frames);
+  }
+}
