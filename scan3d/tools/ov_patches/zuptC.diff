+// zuptC (2026-10-22, scan3d docs/zupt_fixC_plan.md): same bookkeeping as the rejection path of try_update()
+// (time offset moves forward, streak counters cleared). No EKF update, no feature-database change.
+void UpdaterZeroVelocity::zuptC_reset_streak(std::shared_ptr<State> state) {
+  if (!have_last_prop_time_offset) {
+    last_prop_time_offset = state->_calib_dt_CAMtoIMU->value()(0);
+    have_last_prop_time_offset = true;
+  }
+  last_prop_time_offset = state->_calib_dt_CAMtoIMU->value()(0);
+  last_zupt_state_timestamp = 0.0;
+  last_zupt_count = 0;
+}
