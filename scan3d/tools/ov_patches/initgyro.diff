+  // (open_vins_initgyro) gyro stillness of the bias window: max over 0.1 s sub-windows of |mean gyro|
+  if (params.init_max_gyro > 0.0) {
+    double t_lo = newesttime - 1.0 * params.init_window_time;
+    int nbin = std::max(1, (int)std::ceil(0.5 * params.init_window_time / 0.1 - 1e-9));
+    std::vector<Eigen::Vector3d> wsum(nbin, Eigen::Vector3d::Zero());
+    std::vector<int> wcnt(nbin, 0);
+    for (const ImuData &data : window_2to1) {
+      int b = std::min(nbin - 1, std::max(0, (int)std::floor((data.timestamp - t_lo) / 0.1)));
+      wsum.at(b) += data.wm;
+      wcnt.at(b)++;
+    }
+    double g_max = 0.0;
+    for (int b = 0; b < nbin; b++) {
+      if (wcnt.at(b) > 0)
+        g_max = std::max(g_max, (wsum.at(b) / wcnt.at(b)).norm());
+    }
+    if (g_max > params.init_max_gyro) {
+      PRINT_INFO(YELLOW "[init-s]: gyro not still in bias window, %.4f > %.4f rad/s\n" RESET, g_max, params.init_max_gyro);
+      return false;
+    }
+    PRINT_INFO(GREEN "[init-s]: gyro still in bias window, %.4f <= %.4f rad/s\n" RESET, g_max, params.init_max_gyro);
+  }
+
